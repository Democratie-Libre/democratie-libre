{
  "name": "symfony/framework-standard-edition",
  "license": "MIT",
  "type": "project",
  "description": "The \"Symfony Standard Edition\" distribution",
  "autoload": {
    "psr-0": {
      "": "src/"
    },
    "files": [
      "app/AppKernel.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "doctrine/doctrine-bundle": "^2.13",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^2.20",
    "gedmo/doctrine-extensions": "^3.20",
    "michelf/php-markdown": "^2.0",
    "stof/doctrine-extensions-bundle": "^1.14",
    "symfony/asset": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/form": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/monolog-bundle": "^3.10",
    "symfony/security-bundle": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*",
    "twig/twig": "^3.21",
    "twig/intl-extra": "^3.21"
  },
  "require-dev": {
    "phpspec/phpspec": "^8.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.0",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*"
  },
  "config": {
    "bin-dir": "bin",
    "platform": {
      "php": "8.5.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "symfony-scripts": [
      "bin/console cache:clear"
    ],
    "post-install-cmd": [
      "@symfony-scripts"
    ],
    "post-update-cmd": [
      "@symfony-scripts"
    ],
    "stan": "phpstan analyse --level=1 src",
    "specs": "phpspec run -vvv --ansi"
  },
  "extra": {
    "symfony-app-dir": "app",
    "symfony-web-dir": "web",
    "symfony-var-dir": "var",
    "symfony-bin-dir": "bin",
    "symfony-tests-dir": "tests",
    "autoload-dev": {
      "psr-4": {
        "Tests\\": "tests/"
      }
    },
    "branch-alias": {
      "dev-master": "2.4-dev"
    }
  },
  "conflict": {
    "symfony/asset": ">=8.0",
    "symfony/browser-kit": ">=8.0",
    "symfony/cache": ">=8.0",
    "symfony/clock": ">=8.0",
    "symfony/config": ">=8.0",
    "symfony/console": ">=8.0",
    "symfony/css-selector": ">=8.0",
    "symfony/dependency-injection": ">=8.0",
    "symfony/doctrine-bridge": ">=8.0",
    "symfony/dom-crawler": ">=8.0",
    "symfony/error-handler": ">=8.0",
    "symfony/event-dispatcher": ">=8.0",
    "symfony/filesystem": ">=8.0",
    "symfony/finder": ">=8.0",
    "symfony/form": ">=8.0",
    "symfony/http-foundation": ">=8.0",
    "symfony/http-kernel": ">=8.0",
    "symfony/intl": ">=8.0",
    "symfony/monolog-bridge": ">=8.0",
    "symfony/options-resolver": ">=8.0",
    "symfony/password-hasher": ">=8.0",
    "symfony/process": ">=8.0",
    "symfony/property-access": ">=8.0",
    "symfony/property-info": ">=8.0",
    "symfony/routing": ">=8.0",
    "symfony/security-core": ">=8.0",
    "symfony/security-csrf": ">=8.0",
    "symfony/security-http": ">=8.0",
    "symfony/stopwatch": ">=8.0",
    "symfony/string": ">=8.0",
    "symfony/translation": ">=8.0",
    "symfony/twig-bridge": ">=8.0",
    "symfony/type-info": ">=8.0",
    "symfony/validator": ">=8.0",
    "symfony/var-dumper": ">=8.0",
    "symfony/var-exporter": ">=8.0",
    "symfony/yaml": ">=8.0"
  }
}
